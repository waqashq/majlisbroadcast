# --- Android / Gradle build output ---
*.iml
.gradle/
/local.properties
/build/
/*/build/
/captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab

# --- Secrets: real credentials must never be committed ---
# This repo is public. Server host/mount/password live only in a local,
# git-ignored secrets file, never in tracked source.
secrets.properties
secrets.*.properties
*.secrets

# --- Keystores & release signing ---
# The repo is public -- the keystore itself AND the properties file
# pointing to it/holding its passwords must never be committed. Same
# pattern as secrets.properties above. Losing this keystore means losing
# the ability to ever publish an updated build under the same app identity
# -- back it up somewhere safe outside this repo.
*.jks
*.keystore
keystore.properties

# --- IDE / OS ---
.idea/
.vscode/
.DS_Store
Thumbs.db
