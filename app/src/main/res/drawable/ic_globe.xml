<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 11b: globe glyph for the website (waqashq.org) indicator chip. Same outline style as ic_radio. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- outer circle -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.6"
        android:pathData="M3,12 a9,9 0 1 0 18,0 a9,9 0 1 0 -18,0"/>
    <!-- meridian -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.4"
        android:pathData="M8,12 a4,9 0 1 0 8,0 a4,9 0 1 0 -8,0"/>
    <!-- equator + two latitude lines -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.4"
        android:strokeLineCap="round"
        android:pathData="M3,12 h18 M4.8,7.5 h14.4 M4.8,16.5 h14.4"/>
</vector>
